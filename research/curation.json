  },
  "SPB435J1": {
   "story": {
    "text": "A green taken from young bamboo leaves, with a dial pattern based on woven bamboo craft, honouring the bamboo forests of Thai culture."
   }
  },
  "SPB532J1": {
   "story": {
    "text": "A textured white dial that evokes fresh powder snow and untouched high-alpine landscapes."
   }
  },
  "SPB355J1": {
   "story": {
    "text": "A textured silver dial inspired by mountain rock walls. The press links the name to climber Stefano Ghisolfi, who wore it on the granite route ‘Silence’ in Flatanger, Norway."
   }
  }
